# ========================================
# AI Agent 系统环境变量配置模板
# ========================================
# 用法：cp .env.example .env，然后填入你的真实值。
# 说明：本文件仅含「用户关心」的配置项。
# - 敏感/环境专属：密钥、连接串、服务商地址（必填）
# - 部署/容量/业务决策：模型、限流配额、并发、上下文窗口、安全边界
# 内部可靠性调优项（熔断阈值、退避参数等）在 app/config/settings.py 有合理默认值，
# 一般无需在此配置；如需覆盖可新增同名大写键（Pydantic 自动读取）。

# ===== 应用配置 =====
APP_NAME="AI Agent System"
DEBUG=false

# ===== API 配置 =====
API_PREFIX="/api"
CORS_ORIGINS=["*"]

# ===== LLM 主模型配置 =====
# 用于主要对话和决策
# [必填] 你的 LLM API Key（OpenAI / DeepSeek 等）
LLM_API_KEY="your-api-key"
# [必填] API 服务商地址（OpenAI / DeepSeek 等）
LLM_BASE_URL="https://api.openai.com/v1"
# [必填] 主模型 ID
LLM_MODEL_ID="gpt-4"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# ===== LLM 推理模型配置 =====
# 用于深度思考和复杂推理（如数学、代码）
# 如果为空，则使用主模型
LLM_REASONING_MODEL_ID=""
LLM_REASONING_TEMPERATURE=0.7
LLM_REASONING_MAX_TOKENS=8192

# ===== LLM 快速模型配置 =====
# 用于简单任务（分类、提取、快速响应）
# 如果为空，则使用主模型
LLM_FAST_MODEL_ID=""
LLM_FAST_TEMPERATURE=0.0
LLM_FAST_MAX_TOKENS=2048

# ===== LLM 嵌入模型配置 =====
# 用于向量化（记忆、检索）
LLM_EMBEDDING_MODEL_ID="text-embedding-3-small"
LLM_EMBEDDING_DIMENSIONS=1536

# ===== LLM 限流配置 =====
# RPM（每分钟请求数）/ TPM（每分钟 Token）与服务商限额强相关，换服务商请同步调整
LLM_MAIN_RPM=60
LLM_MAIN_TPM=2000000
LLM_REASONING_RPM=30
LLM_REASONING_TPM=2000000
LLM_FAST_RPM=100
LLM_FAST_TPM=2000000

# ===== LLM 降级与代理 =====
# 主模型全部失败时降级到备用模型（空=不启用）
LLM_FALLBACK_MODEL_ID=""
# HTTP 代理（空=不启用）
LLM_PROXY_URL=""

# ===== 上下文配置 =====
MAX_CONTEXT_TOKENS=128000
MAX_OUTPUT_TOKENS=4096
MAX_HISTORY_ROUNDS=20

# ===== Agent 基础配置 =====
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT=300
AGENT_STREAMING=true

# ===== Agent 默认优先级 =====
AGENT_DEFAULT_PRIORITY="normal"

# ===== Agent 并发控制配置 =====
AGENT_MAX_CONCURRENT_TASKS=10
AGENT_MAX_CONCURRENT_TOOLS=3

# ===== 记忆系统配置 =====
MEMORY_ENABLED=false
MEMORY_MAX_SHORT_TERM=10
MEMORY_VECTOR_DB="milvus"
MEMORY_COLLECTION="agent_memory"

# ===== 数据库配置 =====
# [必填] 数据库连接串（未安装 asyncpg 驱动时连接失败，服务仍可降级启动）
DATABASE_URL="postgresql+asyncpg://user:pass@localhost/db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== Redis 配置 =====
# [必填] Redis 连接地址（聊天/会话接口依赖 Redis）
REDIS_URL="redis://localhost:6379/0"
REDIS_SESSION_TTL=604800

# ===== 工具配置 =====
TOOL_TIMEOUT=30
TOOL_MAX_RETRIES=3
# readFile/writeFile 允许目录白名单（JSON 数组；默认项目根）
# TOOL_ALLOWED_DIRS=["/data/yield"]
# external http_api 示例工具请求超时（秒）
# TOOL_HTTP_TIMEOUT=15

# ===== Tavily API 配置 =====
# 用于网络搜索功能，注册地址：https://tavily.com
# [必填] 如需启用 search 工具
TAVILY_API_KEY="your-tavily-api-key"
TAVILY_SEARCH_DEPTH="basic"

# ===== 日志配置 =====
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_FILE="logs/app.log"

# ===== 监控配置 =====
METRICS_ENABLED=false
METRICS_PORT=9090

# ===== 安全配置 =====
# [必填] JWT 密钥（生产环境请使用强密钥，如 `python -c "import secrets; print(secrets.token_hex(32))"`）
JWT_SECRET_KEY="your-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440
